# Целевые узлы — Linux. Всё текстовое держим в LF.
* text=auto eol=lf

*.go   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.sh   text eol=lf

*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

*.dll binary
*.exe binary
*.so  binary
*.dat binary
*.zip binary
